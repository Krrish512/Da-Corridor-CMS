datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  avatar              String?
  role                String    @default("ADMIN") // SUPER_ADMIN, ADMIN, CO_ADMIN
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  deactivatedAt       DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime? // Soft delete

  @@index([deletedAt])
}

model HeroSection {
  id              String    @id @default(uuid())
  heading         String
  subHeading      String
  backgroundImage String?
  backgroundVideo String?
  ctaText         String
  ctaLink         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete
}

model AboutSection {
  id           String    @id @default(uuid())
  name         String
  profession   String
  about        String
  biography    String
  experience   Int       // Years of experience
  skills       String    // Comma-separated or lines
  vision       String
  mission      String
  resumeUrl    String?
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete
}

model Achievement {
  id                String    @id @default(uuid())
  yearsExperience   Int       @default(0)
  projectsCompleted Int       @default(0)
  happyClients      Int       @default(0)
  awards            Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete
}

model ProcessStep {
  id          String    @id @default(uuid())
  stepNumber  Int
  title       String
  description String
  icon        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete

  @@index([deletedAt, stepNumber])
}

model WhyChooseUs {
  id          String    @id @default(uuid())
  icon        String
  title       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
}

model Service {
  id                     String    @id @default(uuid())
  title                  String
  icon                   String
  shortDescription       String
  fullDescription        String
  image                  String?
  displayOrder           Int       @default(0)
  isActive               Boolean   @default(true)
  publishingStatus       String    @default("PUBLISHED") // "DRAFT", "PENDING_APPROVAL", "PUBLISHED", "ARCHIVED"
  scheduledPublishAt     DateTime?
  scheduledUnpublishAt   DateTime?
  submittedForApprovalAt DateTime?
  approvedById           String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? // Soft delete

  @@index([deletedAt, publishingStatus, isActive])
  @@index([displayOrder])
}

model Project {
  id                     String         @id @default(uuid())
  title                  String
  slug                   String         @unique
  category               String
  coverImage             String
  images                 ProjectImage[]
  clientName             String
  location               String
  area                   String
  completionDate         DateTime
  status                 String         // e.g. "Completed", "In Progress", "Concept"
  publishingStatus       String         @default("PUBLISHED") // "DRAFT", "PENDING_APPROVAL", "PUBLISHED", "ARCHIVED"
  scheduledPublishAt     DateTime?
  scheduledUnpublishAt   DateTime?
  submittedForApprovalAt DateTime?
  approvedById           String?
  createdById            String?
  description            String
  designChallenge        String
  solution               String
  materials              String         // Comma-separated tags or materials
  featured               Boolean        @default(false)
  seoTitle               String?
  seoDescription         String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?      // Soft delete

  @@index([deletedAt, publishingStatus, featured])
  @@index([category])
}

model ProjectImage {
  id        String   @id @default(uuid())
  url       String
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model GalleryItem {
  id        String    @id @default(uuid())
  type      String    // "IMAGE" or "VIDEO"
  url       String
  category  String    // e.g. "Residential", "Commercial"
  folder    String    @default("root")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([deletedAt, folder])
}

model Testimonial {
  id                     String    @id @default(uuid())
  clientName             String
  company                String
  designation            String
  profileImage           String?
  rating                 Int       @default(5)
  review                 String
  isActive               Boolean   @default(true)
  publishingStatus       String    @default("PUBLISHED") // "DRAFT", "PENDING_APPROVAL", "PUBLISHED", "ARCHIVED"
  scheduledPublishAt     DateTime?
  scheduledUnpublishAt   DateTime?
  submittedForApprovalAt DateTime?
  approvedById           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? // Soft delete

  @@index([deletedAt, publishingStatus, isActive])
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String
  position  String
  photo     String?
  bio       String
  facebook  String?
  twitter   String?
  linkedin  String?
  instagram String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([deletedAt])
}

model Partner {
  id          String    @id @default(uuid())
  companyName String
  logo        String
  websiteUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete

  @@index([deletedAt])
}

model BlogPost {
  id                     String    @id @default(uuid())
  title                  String
  slug                   String    @unique
  category               String
  tags                   String    // Comma-separated
  featuredImage          String
  richText               String
  seoTitle               String?
  seoDescription         String?
  publishingStatus       String    @default("PUBLISHED") // "DRAFT", "PENDING_APPROVAL", "PUBLISHED", "ARCHIVED"
  scheduledPublishAt     DateTime?
  scheduledUnpublishAt   DateTime?
  submittedForApprovalAt DateTime?
  approvedById           String?
  createdById            String?
  publishDate            DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? // Soft delete

  @@index([deletedAt, publishingStatus])
  @@index([category])
}

model FAQ {
  id           String    @id @default(uuid())
  question     String
  answer       String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete

  @@index([deletedAt, displayOrder])
}

model ContactDetails {
  id             String    @id @default(uuid())
  officeAddress  String
  email          String
  phone          String
  whatsApp       String?
  googleMapsUrl  String?
  workingHours   String?
  socialFacebook String?
  socialTwitter  String?
  socialLinkedin String?
  socialInsta    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String
  subject   String
  message   String
  status    String    @default("UNREAD") // "UNREAD", "READ", "REPLIED"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([deletedAt, status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}

model SEOSettings {
  id                        String    @id @default(uuid())
  homepageTitle             String
  metaDescription           String
  keywords                  String
  ogImage                   String?
  googleAnalyticsId         String?
  searchConsoleVerification String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime? // Soft delete
}

model SystemSettings {
  id              String    @id @default(uuid())
  websiteLogo     String?
  favicon         String?
  themeColors     String    @default("default")
  footerText      String?
  maintenanceMode Boolean   @default(false)
  timezone        String    @default("UTC")
  language        String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete
}

model ActivityLog {
  id            String   @id @default(uuid())
  action        String   // e.g. "CREATED_PROJECT", "UPDATED_ABOUT"
  details       String
  previousValue String?  // JSON string of state before mutation
  newValue      String?  // JSON string of state after mutation
  userEmail     String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id            String    @id @default(uuid())
  type          String    // e.g. CONTACT_INQUIRY, BLOG_SUBMITTED, BLOG_APPROVED, BLOG_REJECTED, etc.
  title         String
  message       String
  entityType    String    // e.g. ContactMessage, BlogPost, Project, Service, GalleryItem
  entityId      String?
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isRead        Boolean   @default(false)
  senderId      String?   // User who triggered action
  recipientId   String?   // Targeted user ID (e.g. original author)
  recipientRole String?   // Targeted role (e.g. SUPER_ADMIN for approval requests)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  @@index([deletedAt, isRead])
  @@index([deletedAt, recipientId, isRead])
  @@index([deletedAt, recipientRole, isRead])
  @@index([createdAt])
}
