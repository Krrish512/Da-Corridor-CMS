datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("ADMIN") // Only admin login as requested, but structured role-wise
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}

model HeroSection {
  id              String    @id @default(uuid())
  heading         String
  subHeading      String
  backgroundImage String?
  backgroundVideo String?
  ctaText         String
  ctaLink         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete
}

model AboutSection {
  id           String    @id @default(uuid())
  name         String
  profession   String
  about        String
  biography    String
  experience   Int // Years of experience
  skills       String // Comma-separated or lines
  vision       String
  mission      String
  resumeUrl    String?
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete
}

model Achievement {
  id                String    @id @default(uuid())
  yearsExperience   Int       @default(0)
  projectsCompleted Int       @default(0)
  happyClients      Int       @default(0)
  awards            Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete
}

model ProcessStep {
  id          String    @id @default(uuid())
  stepNumber  Int
  title       String
  description String
  icon        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
}

model WhyChooseUs {
  id          String    @id @default(uuid())
  icon        String
  title       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
}

model Service {
  id               String    @id @default(uuid())
  title            String
  icon             String
  shortDescription String
  fullDescription  String
  image            String?
  displayOrder     Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // Soft delete
}

model Project {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  category        String
  coverImage      String
  images          ProjectImage[]
  clientName      String
  location        String
  area            String
  completionDate  DateTime
  status          String // e.g. "Completed", "In Progress", "Concept"
  description     String
  designChallenge String
  solution        String
  materials       String // Comma-separated tags or materials
  featured        Boolean        @default(false)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime? // Soft delete
}

model ProjectImage {
  id        String   @id @default(uuid())
  url       String
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String    @id @default(uuid())
  type      String // "IMAGE" or "VIDEO"
  url       String
  category  String // e.g. "Residential", "Commercial"
  folder    String    @default("root")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}

model Testimonial {
  id           String    @id @default(uuid())
  clientName   String
  company      String
  designation  String
  profileImage String?
  rating       Int       @default(5)
  review       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String
  position  String
  photo     String?
  bio       String
  facebook  String?
  twitter   String?
  linkedin  String?
  instagram String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}

model Partner {
  id          String    @id @default(uuid())
  companyName String
  logo        String
  websiteUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
}

model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  category       String
  tags           String // Comma-separated
  featuredImage  String
  richText       String
  seoTitle       String?
  seoDescription String?
  publishDate    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete
}

model FAQ {
  id           String    @id @default(uuid())
  question     String
  answer       String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete
}

model ContactDetails {
  id             String    @id @default(uuid())
  officeAddress  String
  email          String
  phone          String
  whatsApp       String?
  googleMapsUrl  String?
  workingHours   String?
  socialFacebook String?
  socialTwitter  String?
  socialLinkedin String?
  socialInsta    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String
  subject   String
  message   String
  status    String    @default("UNREAD") // "UNREAD", "READ", "REPLIED"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}

model NewsletterSubscriber {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}

model SEOSettings {
  id                        String    @id @default(uuid())
  homepageTitle             String
  metaDescription           String
  keywords                  String
  ogImage                   String?
  googleAnalyticsId         String?
  searchConsoleVerification String?
  robotsText                String?
  sitemapXml                String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime? // Soft delete
}

model SystemSettings {
  id              String    @id @default(uuid())
  websiteLogo     String?
  favicon         String?
  themeColors     String    @default("default")
  footerText      String?
  maintenanceMode Boolean   @default(false)
  timezone        String    @default("UTC")
  language        String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String // e.g. "CREATED_PROJECT", "UPDATED_ABOUT"
  details   String
  userEmail String
  createdAt DateTime @default(now())
}
