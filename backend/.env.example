# ==============================================================================
# Architecture & Spatial Design CMS - Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with valid environment values before starting.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Configuration
# ------------------------------------------------------------------------------
# Server listening port (Default: 5000)
PORT=5000

# Application execution environment ('development' or 'production')
NODE_ENV=production

# Public URL of the frontend web application
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration (Prisma ORM)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/dacorridorcms?schema=public

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (min 32 random characters)
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_2026

# Standard JWT token expiration timeframe (e.g. 24h, 7d)
JWT_EXPIRE=24h

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing) Security
# ------------------------------------------------------------------------------
# Comma-separated list of trusted web origins allowed to access the backend API.
# DO NOT include trailing slashes or use wildcard (*) when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 5. One-Time Administrative Setup Credentials (createAdmin.js)
# ------------------------------------------------------------------------------
# Credentials used by 'node scripts/createAdmin.js' to initialize/update SUPER_ADMIN
INITIAL_ADMIN_NAME=Production Administrator
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your_secure_complex_password_min_12_chars

# ------------------------------------------------------------------------------
# 6. Email Service Configuration (Nodemailer SMTP)
# ------------------------------------------------------------------------------
# SMTP server hostname for transactional emails (Contact forms, password reset)
SMTP_HOST=smtp.mailtrap.io

# SMTP server port (e.g. 587 for TLS, 465 for SSL, 2525 for Mailtrap)
SMTP_PORT=2525

# SMTP authentication username
SMTP_USER=your_smtp_username

# SMTP authentication password
SMTP_PASS=your_smtp_password

# Sender email address for outgoing system emails
SENDER_EMAIL=noreply@dacorridor.com

# ------------------------------------------------------------------------------
# 7. File Upload Storage
# ------------------------------------------------------------------------------
# Directory path for storing uploaded media assets (Default: uploads)
UPLOAD_PATH=uploads
